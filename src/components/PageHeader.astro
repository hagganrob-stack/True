---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SectionLabel from './SectionLabel.astro';
import { PAGE_HEADER_WIDTHS, PAGE_HEADER_SIZES } from '../lib/images';

/**
 * Header for inner pages: breadcrumbs, eyebrow, h1, intro and a portrait
 * image. The image is the LCP element, so it loads eagerly; pass the same
 * widths/sizes to the layout's `preload` prop.
 */
interface Props {
  crumbs: { name: string; path: string }[];
  eyebrow: string;
  title: string;
  image: { src: ImageMetadata; alt: string; position?: string };
  /** `portrait` (4:5) for people, `landscape` (4:3) for stock. */
  shape?: 'portrait' | 'landscape';
}
const { crumbs, eyebrow, title, image, shape = 'portrait' } = Astro.props;
---

<section class="border-b border-line" aria-labelledby="page-title">
  <div class="container-site pt-4 pb-14 md:pt-6 md:pb-20">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 grid items-center gap-10 md:mt-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-7">
        <SectionLabel>{eyebrow}</SectionLabel>
        <h1 id="page-title" class="mt-3">{title}</h1>
        <div class="intro mt-5 text-ink">
          <slot />
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <slot name="actions" />
        </div>
      </div>
      <div class="relative md:col-span-5">
        <div aria-hidden="true" class="absolute -right-3 -bottom-3 hidden h-2/3 w-2/3 rounded-[12px] bg-taupe md:block"></div>
        <Picture
          src={image.src}
          alt={image.alt}
          formats={['avif', 'webp']}
          widths={PAGE_HEADER_WIDTHS}
          sizes={PAGE_HEADER_SIZES}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class:list={[
            'relative w-full rounded-[12px] object-cover',
            shape === 'portrait' ? 'aspect-[4/5]' : 'aspect-[4/3]',
          ]}
          style={image.position ? `object-position: ${image.position}` : undefined}
        />
      </div>
    </div>
  </div>
</section>
