---
import MapPin from '@lucide/astro/icons/map-pin';
import { business, links } from '../content/site';
import NewTab from './NewTab.astro';

/**
 * Click-to-load Google Map. Nothing from Google loads until the visitor
 * presses "Show map" – keeps the page fast and cookie-free.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col gap-4', className]}>
  <div
    class="relative aspect-[4/3] w-full overflow-hidden rounded-[12px] border border-line bg-surface-soft"
    data-map
    data-src={links.mapEmbed}
  >
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center" data-map-placeholder>
      <!-- Soft street-grid pattern as the placeholder "image" -->
      <svg aria-hidden="true" class="absolute inset-0 h-full w-full text-line" preserveAspectRatio="none">
        <defs>
          <pattern id="map-grid" width="56" height="56" patternUnits="userSpaceOnUse" patternTransform="rotate(12)">
            <path d="M0 28h56M28 0v56" stroke="currentColor" stroke-width="6" fill="none"></path>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#map-grid)"></rect>
      </svg>
      <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-ink text-white shadow-sm">
        <MapPin size={26} stroke-width={1.5} aria-hidden="true" />
      </span>
      <p class="relative rounded-lg bg-surface/90 px-3 py-1 text-small font-medium">{business.addressLine}</p>
      <button type="button" class="btn btn-secondary btn-sm relative bg-surface" data-map-load>
        Show map
      </button>
      <p class="relative text-[12px] leading-snug text-ink-muted">Loads Google Maps</p>
    </div>
  </div>
  <a href={links.directions} target="_blank" rel="noopener" class="link inline-flex min-h-11 items-center gap-2 self-start">
    <MapPin size={18} stroke-width={1.5} aria-hidden="true" /> Get directions to True Hairdressers<NewTab />
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((wrap) => {
    wrap.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = wrap.dataset.src ?? '';
      iframe.title = 'Map showing True Hairdressers, 75 Home Farm Crescent, Whitnash';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.setAttribute('allowfullscreen', '');
      wrap.querySelector('[data-map-placeholder]')?.remove();
      wrap.appendChild(iframe);
      iframe.focus();
    });
  });
</script>
