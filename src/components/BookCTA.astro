---
import { Image } from 'astro:assets';
import Phone from '@lucide/astro/icons/phone';
import BookButton from './BookButton.astro';
import PhoneLink from './PhoneLink.astro';
import flatlay from '../assets/stock/hair-tools-flatlay.jpg';

interface Props {
  heading?: string;
  location?: string;
}
const { heading = 'Ready for a fresh look?', location = 'cta-band' } = Astro.props;
---

<section class="on-dark relative isolate overflow-hidden bg-dark text-white" aria-labelledby="book-cta-heading">
  <Image
    src={flatlay}
    alt=""
    widths={[640, 1024, 1500]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-dark/55"></div>
  <div class="container-site py-20 text-center md:py-24">
    <p class="eyebrow">Book online in a couple of taps</p>
    <h2 id="book-cta-heading" class="mt-3 text-white">{heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-taupe-light">
      See every service, price and free slot on Fresha, with reminders before your appointment.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-5 sm:flex-row">
      <BookButton variant="light" location={location} />
      <p class="flex items-center gap-2 text-small">
        <Phone size={18} stroke-width={1.5} aria-hidden="true" class="text-taupe-light" />
        <span>Prefer to call? <PhoneLink location={location} /></span>
      </p>
    </div>
  </div>
</section>
