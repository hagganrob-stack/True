---
import { Image } from 'astro:assets';
import logo from '../assets/logos/true-logo.png';

/**
 * True Hairdressers logo – the stacked "T" roundel + TRUE wordmark supplied
 * by Rachel (Nov 2026). Used in the header, footer and anywhere else.
 * Size it with a height class, e.g. `h-16`. The source PNG is 252×393px
 * (transparent), so ask for an SVG/high-res version for print or big uses.
 */
interface Props {
  class?: string;
  /** Load eagerly in the header (above the fold); lazily elsewhere. */
  eager?: boolean;
}
const { class: className = 'h-16', eager = false } = Astro.props;
---

<Image
  src={logo}
  alt="True Hairdressers"
  height={96}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['w-auto', className]}
/>
