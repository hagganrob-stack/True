---
import { Picture } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import SectionLabel from './SectionLabel.astro';
import Confirm from './Confirm.astro';
import closeup from '../assets/photos/rachel-monty-closeup.jpg';
---

<section class="py-16 md:py-24" aria-labelledby="intro-heading">
  <div class="container-site grid items-center gap-10 md:grid-cols-12 md:gap-16">
    <div class="relative md:col-span-5">
      <div aria-hidden="true" class="absolute -bottom-4 -left-4 hidden h-2/3 w-2/3 rounded-[12px] bg-taupe md:block"></div>
      <Picture
        src={closeup}
        alt="Rachel, owner of True Hairdressers, smiling and holding her dog Monty cheek to cheek"
        formats={['avif', 'webp']}
        widths={[400, 600, 800, 1066]}
        sizes="(min-width: 768px) 40vw, 92vw"
        loading="lazy"
        decoding="async"
        class="relative aspect-[4/5] w-full rounded-[12px] object-cover"
        style="object-position: 50% 20%"
      />
    </div>
    <div class="md:col-span-7">
      <SectionLabel>Meet Rachel</SectionLabel>
      <h2 id="intro-heading" class="mt-3">Born and bred in Whitnash</h2>
      <div class="intro mt-6 space-y-5 text-ink">
        <p>
          I'm Rachel. I've lived in Whitnash all my life, and True is my little salon in the heart of the
          community.
        </p>
        <p>
          Whether you're after a quick trim, a brand-new colour or your hair up for a big day, you'll get an
          honest chat, a cuppa <Confirm note="offer drinks?" /> and hair you'll love. Monty will probably say
          hello too.
        </p>
      </div>
      <a href="/about/" class="link mt-8 inline-flex min-h-11 items-center gap-1.5 text-[17px]">
        Meet Rachel <ArrowRight size={18} stroke-width={1.5} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
