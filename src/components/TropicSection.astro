---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionLabel from './SectionLabel.astro';
import NewTab from './NewTab.astro';
import { links, tropic } from '../content/site';
import tropicLogo from '../assets/logos/tropic.svg';

/**
 * Rachel's Tropic Ambassador shop. Kept separate from the salon's own
 * products (Goldwell and Maria Nila). Wording follows Tropic's own
 * description of Ambassadors – no product claims.
 */
---

<section id="tropic" class="scroll-mt-24 border-y border-line bg-surface-soft py-16 md:py-20" aria-labelledby="tropic-heading">
  <div class="container-site">
    <div class="grid items-center gap-8 rounded-[12px] border border-line bg-surface p-6 md:grid-cols-12 md:gap-12 md:p-10">
      <div class="flex items-center justify-center rounded-[12px] bg-bg px-8 py-8 md:col-span-4 md:py-12 md:h-full">
        <Image src={tropicLogo} alt="Tropic" width={208} height={36} loading="lazy" decoding="async" class="h-auto w-48 max-w-full" />
      </div>
      <div class="md:col-span-8">
        <SectionLabel>Also from Rachel</SectionLabel>
        <h2 id="tropic-heading" class="mt-3">I'm a {tropic.role}</h2>
        <p class="mt-4 max-w-prose text-[18px] leading-[30px]">
          As well as doing your hair, I sell Tropic skincare and beauty. Shop online through my Tropic page and your
          order is linked to my small business – a lovely way to support me.
        </p>
        <a
          href={links.tropic}
          target="_blank"
          rel="noopener"
          class="btn btn-secondary mt-7"
          data-track="Tropic click"
          data-track-location="about-tropic"
        >
          {tropic.linkLabel}
          <ArrowUpRight size={18} stroke-width={1.5} aria-hidden="true" />
          <NewTab />
        </a>
      </div>
    </div>
  </div>
</section>
