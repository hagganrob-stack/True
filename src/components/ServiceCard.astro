---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';

interface Props {
  name: string;
  summary: string;
  href: string;
  /** Descriptive link text for SEO/screen readers, e.g. "hair colour in Whitnash". */
  linkText: string;
  icon: any;
  image?: { src: ImageMetadata; alt: string; position?: string };
}
const { name, summary, href, linkText, icon: Icon, image } = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-[12px] border border-line bg-surface transition-shadow hover:shadow-[0_8px_30px_-12px_rgba(44,44,44,0.25)]">
  {
    image && (
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        widths={[360, 560, 720]}
        sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 92vw"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover"
        style={image.position ? `object-position: ${image.position}` : undefined}
      />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-surface-soft text-taupe-text">
      <Icon size={22} stroke-width={1.5} aria-hidden="true" />
    </span>
    <h3 class="mt-4">{name}</h3>
    <p class="mt-2 flex-1 text-ink-muted">{summary}</p>
    <a href={href} class="link mt-5 inline-flex min-h-11 items-center gap-1.5 after:absolute after:inset-0 after:content-['']">
      <span class="first-letter:uppercase">{linkText}</span>
      <ArrowRight size={18} stroke-width={1.5} aria-hidden="true" class="transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</article>
