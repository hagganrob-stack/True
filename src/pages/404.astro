---
import { Picture } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../content/site';
import monty from '../assets/photos/monty-woodland-path.jpg';

const descriptions: Record<string, string> = {
  '/': 'Back to the start',
  '/services/': 'Cuts, colour, blow-dries and hair up',
  '/about/': 'Meet Rachel (and Monty)',
  '/book/': 'Book online, opening hours and directions',
};
---

<BaseLayout
  title="Page not found | True Hairdressers"
  description="Sorry, we couldn't find that page. Try the homepage, services, about or booking pages instead."
  noindex
>
  <section class="py-16 md:py-24" aria-labelledby="nf-heading">
    <div class="container-site grid items-center gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <Picture
          src={monty}
          alt="Monty, True Hairdressers' Head of Client Happiness, sitting on a woodland path"
          formats={['avif', 'webp']}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 460px, (min-width: 768px) 40vw, 92vw"
          loading="eager"
          decoding="async"
          class="mx-auto aspect-[4/5] w-full max-w-sm rounded-[12px] object-cover md:max-w-none"
          style="object-position: 42% 60%"
        />
      </div>
      <div class="md:col-span-7">
        <p class="eyebrow">Error 404</p>
        <h1 id="nf-heading" class="mt-3">Oops – this page has wandered off</h1>
        <p class="intro mt-5">
          Monty's had a good sniff around and can't find it anywhere. Try one of these instead:
        </p>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="group flex min-h-14 items-center justify-between gap-4 py-3 no-underline">
                  <span>
                    <span class="block font-serif text-[22px] font-medium text-ink group-hover:underline decoration-taupe underline-offset-4">{item.label}</span>
                    <span class="text-small text-ink-muted">{descriptions[item.href]}</span>
                  </span>
                  <ArrowRight size={20} stroke-width={1.5} aria-hidden="true" class="shrink-0 text-taupe-text" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
